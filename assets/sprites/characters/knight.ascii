# Knight Player Character
NAME: Knight
WIDTH: 9
HEIGHT: 7
ANCHOR: 4,6
HURTBOX: 2,0,5,7

ANIMATIONS:
idle = frames:idle_0,idle_1 durations:20,20 loop:true
run = frames:run_0,run_1,run_2,run_3 durations:6,6,6,6 loop:true
jump = frames:jump_0 durations:10 loop:false
fall = frames:fall_0 durations:10 loop:false
attack1 = frames:atk1_0,atk1_1,atk1_2 durations:4,5,7 loop:false damage:1[5,1,4,4]
attack2 = frames:atk2_0,atk2_1,atk2_2 durations:4,5,7 loop:false damage:1[4,0,5,5]
attack3 = frames:atk3_0,atk3_1,atk3_2,atk3_3 durations:5,6,7,9 loop:false damage:2[3,0,6,6]*1.5
heavy_charge = frames:hvy_chg_0,hvy_chg_1 durations:8,8 loop:true
heavy_release = frames:hvy_rel_0,hvy_rel_1,hvy_rel_2 durations:5,6,10 loop:false damage:1[2,0,7,7]*2.0
special = frames:spec_0,spec_1,spec_2 durations:5,6,10 loop:false damage:1[2,0,7,7]*2.2
dodge = frames:dodge_0,dodge_1,dodge_2 durations:4,5,7 loop:false
block = frames:block_0 durations:10 loop:true
hurt = frames:hurt_0 durations:10 loop:false
death = frames:death_0,death_1,death_2 durations:8,10,30 loop:false

